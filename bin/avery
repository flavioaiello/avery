#!/bin/bash
# avery - private AI agent on macOS: Goose Desktop + local model (Splash) + Apple Mail and Calendar bridge.
# Layout (same in the git checkout and in the Homebrew prefix):
#   bin/avery  bin/avery-mail  libexec/avery-make-app  share/avery/...
set -euo pipefail

AVERY_VERSION="0.5.0"

resolve_path() {
  local target="$1" dir
  while [ -L "$target" ]; do
    dir="$(cd "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    case "$target" in /*) ;; *) target="$dir/$target" ;; esac
  done
  echo "$(cd "$(dirname "$target")" && pwd)/$(basename "$target")"
}

SELF="$(resolve_path "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
LIBEXEC="$ROOT/libexec"
SHARE="$ROOT/share/avery"

AVERY_HOME="${AVERY_HOME:-$HOME/.avery}"
export AVERY_HOME

say() { printf '%s\n' "$*"; }
die() { printf 'avery: %s\n' "$*" >&2; exit 1; }

# $AVERY_HOME/avery.env holds KEY=VALUE lines. Only known keys are read and the real
# environment wins. The file is parsed, not executed.
load_env() {
  local file="$AVERY_HOME/avery.env" line key val
  [ -f "$file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|\#*) continue ;; esac
    key="${line%%=*}"
    val="${line#*=}"
    case "$key" in
      AVERY_MODEL|AVERY_MAX_MEMORY|AVERY_MAX_CONTEXT|AVERY_MAX_CACHE_DISK|AVERY_OFFLINE|AVERY_IDLE_MINUTES|AVERY_GOOSE_APP|AVERY_GOOSE_ROOT|AVERY_NO_ONBOARD)
        if [ -z "$(printenv "$key" 2>/dev/null || true)" ]; then export "$key=$val"; fi ;;
    esac
  done < "$file"
}
load_env

GOOSE_ROOT="${AVERY_GOOSE_ROOT:-$AVERY_HOME/goose}"
GOOSE_APP="${AVERY_GOOSE_APP:-/Applications/Goose.app}"
MODEL_URL="${AVERY_MODEL_URL:-http://127.0.0.1:8000/health}"
SYSTEM_APP="${AVERY_SYSTEM_APP:-/Applications/Avery.app}"

# AVERY_DRY_RUN=1 prints the command instead of running it (used by the tests).
launch() {
  if [ "${AVERY_DRY_RUN:-}" = "1" ]; then
    printf '%s\n' "$*"
    return 0
  fi
  exec "$@"
}

# Like launch, but returns so that the caller can continue.
run_cmd() {
  if [ "${AVERY_DRY_RUN:-}" = "1" ]; then
    printf '%s\n' "$*"
    return 0
  fi
  "$@"
}

brew_bin() { command -v brew 2>/dev/null || echo /opt/homebrew/bin/brew; }

model_healthy() { curl -s -m 2 -o /dev/null "$MODEL_URL"; }

# Any Goose process (Desktop, its helpers, the CLI) / Goose running with the Avery profile.
goose_running() { pgrep -f "$GOOSE_APP/Contents/" >/dev/null 2>&1; }
goose_uses_profile() { pgrep -f "GOOSE_PATH_ROOT\":\"$GOOSE_ROOT\"" >/dev/null 2>&1; }

watch_pidfile() { echo "$AVERY_HOME/watch.pid"; }

# 0 if the pid in the pid file belongs to a running "avery watch".
watcher_alive() {
  local pid
  [ -f "$(watch_pidfile)" ] || return 1
  pid="$(cat "$(watch_pidfile)" 2>/dev/null || true)"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o command= 2>/dev/null | grep -q " watch"
}

start_watcher() {
  if [ "${AVERY_DRY_RUN:-}" = "1" ]; then
    say "(Trockenlauf) Waechter im Hintergrund: avery watch"
    return 0
  fi
  mkdir -p "$AVERY_HOME"
  nohup "$SELF" watch </dev/null >>"$AVERY_HOME/watch.log" 2>&1 &
  disown 2>/dev/null || true
}

stop_watcher() {
  local pid
  if watcher_alive; then
    pid="$(cat "$(watch_pidfile)")"
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$(watch_pidfile)"
}

# 0 = valid, 1 = invalid, 2 = cannot check (no ruby)
yaml_valid() {
  command -v ruby >/dev/null 2>&1 || return 2
  ruby -ryaml -e 'YAML.load_file(ARGV[0])' "$1" >/dev/null 2>&1
}

# Is the model already in the Hugging Face cache? Offline mode cannot start without it.
model_cached() {
  local model="${AVERY_MODEL:-unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_M}" repo
  repo="${model%%:*}"
  [ -d "${HF_HOME:-$HOME/.cache/huggingface}/hub/models--${repo//\//--}/snapshots" ]
}

mail_bin() {
  local candidate stable=""
  if [ -n "${AVERY_MAIL_BIN:-}" ]; then
    echo "$AVERY_MAIL_BIN"
    return 0
  fi
  case "$ROOT" in
    */Cellar/*)
      stable="$(command -v avery-mail 2>/dev/null || true)"
      if [ -n "$stable" ]; then
        echo "$stable"
        return 0
      fi ;;
  esac
  for candidate in "$ROOT/bin/avery-mail" "$ROOT/avery-mail/target/release/avery-mail"; do
    if [ -x "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  echo "$ROOT/bin/avery-mail"
}

# The guided first setup in macOS dialogs ("avery mail onboard --if-needed"): it asks only while nothing is set up
# and nothing was dismissed, and it never blocks the start. AVERY_NO_ONBOARD=1 switches it off.
first_setup() {
  local bin
  if [ "${AVERY_NO_ONBOARD:-}" = "1" ]; then return 0; fi
  bin="$(mail_bin)"
  if [ "${AVERY_DRY_RUN:-}" = "1" ]; then
    run_cmd "$bin" onboard --if-needed
    return 0
  fi
  if [ ! -x "$bin" ]; then return 0; fi
  "$bin" onboard --if-needed </dev/null || say "Hinweis: Die Einrichtung in Dialogen ist nicht abgeschlossen. Wiederholen: avery mail onboard" >&2
  return 0
}

sed_escape() { printf '%s' "$1" | sed -e 's/[\\&|]/\\&/g'; }

render() {
  local template="$1" dest="$2" goose mail
  goose="$(sed_escape "$GOOSE_ROOT")"
  mail="$(sed_escape "$(mail_bin)")"
  sed -e "s|@GOOSE_ROOT@|$goose|g" -e "s|@AVERY_MAIL@|$mail|g" "$template" > "$dest"
}

FORCE=0
install_file() {
  local template="$1" dest="$2" mode="${3:-copy}" backup
  mkdir -p "$(dirname "$dest")"
  if [ -e "$dest" ]; then
    if [ "$FORCE" = 1 ]; then
      backup="$dest.bak-$(date +%Y%m%d%H%M%S)"
      cp -p "$dest" "$backup"
      say "  Sicherung: $backup"
    else
      say "  vorhanden, nicht ueberschrieben: $dest"
      return 0
    fi
  fi
  if [ "$mode" = render ]; then render "$template" "$dest"; else cp "$template" "$dest"; fi
  say "  geschrieben: $dest"
}

usage() {
  cat <<EOF
avery $AVERY_VERSION - privater KI-Agent auf macOS (Goose + lokales Modell + Apple Mail und Kalender)

Befehle:
  avery init [--force]   Goose-Profil anlegen (Konfiguration, Rechte, Modell-Anbindung)
  avery mail <befehl>    Konten und Kalender freigeben und pruefen: onboard, setup, accounts, calendars,
                         selftest, selftest-write, sendlog, changes, undo, revoke, status, help
  avery up               Modell als Hintergrunddienst starten, warten bis es bereit ist, dann Goose oeffnen;
                         das Modell stoppt von selbst, wenn Goose einige Minuten geschlossen ist.
                         Solange noch nichts eingerichtet ist, fuehren Dialoge durch die Einrichtung
                         (avery mail onboard; AVERY_NO_ONBOARD=1 schaltet das aus)
  avery down             Modell sofort beenden (gibt den Arbeitsspeicher frei)
  avery install-app      Avery.app in ~/Applications anlegen (ohne Cask; mit Cask ist die App schon da)
  avery pull             Modell einmalig laden (ca. 17 GB), im Vordergrund; mit Ctrl+C beenden, sobald es 'Ready' meldet
  avery model            lokales Modell im Vordergrund starten (zum Testen, ohne Dienst)
  avery app              Goose Desktop mit dem Avery-Profil starten
  avery cli [args]       Goose CLI mit dem Avery-Profil
  avery doctor           Voraussetzungen und Einrichtung pruefen
  avery version          Version anzeigen

Erster Start: avery init, avery pull, dann Avery oeffnen (avery up): Mail und Kalender werden in Dialogen eingerichtet
              (im Terminal stattdessen: avery mail setup, avery mail selftest)
Taeglich:     avery up   (und am Ende avery down)
Einstellungen: $AVERY_HOME/avery.env (siehe README)
EOF
}

cmd_init() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) FORCE=1 ;;
      -h|--help) say "Aufruf: avery init [--force]   (--force ueberschreibt Dateien, mit Sicherung)"; return 0 ;;
      *) die "Unbekannte Option: $1" ;;
    esac
    shift
  done
  [ "$(uname -s)" = "Darwin" ] || die "Avery laeuft nur auf macOS."
  say "Avery-Profil einrichten: $GOOSE_ROOT"
  install_file "$SHARE/goose/config.yaml.tmpl" "$GOOSE_ROOT/config/config.yaml" render
  install_file "$SHARE/goose/permission.yaml" "$GOOSE_ROOT/config/permission.yaml"
  install_file "$SHARE/goose/custom_splash.json" "$GOOSE_ROOT/config/custom_providers/custom_splash.json"
  install_file "$SHARE/goose/top-of-mind.md" "$GOOSE_ROOT/top-of-mind.md"
  install_file "$SHARE/avery.env" "$AVERY_HOME/avery.env"
  mkdir -p "$AVERY_HOME/mail"
  chmod 700 "$AVERY_HOME" "$AVERY_HOME/mail" 2>/dev/null || true
  say ""
  [ -d "$GOOSE_APP" ] || say "Hinweis: Goose Desktop fehlt. Installieren mit: brew install --cask block-goose"
  command -v splash >/dev/null 2>&1 || say "Hinweis: Splash fehlt. Installieren mit: brew install incoai/tap/splash"
  say ""
  say "Weiter mit:"
  say "  avery up               (beim ersten Start fuehren Dialoge durch die Einrichtung von Mail und Kalender; wiederholen: avery mail onboard)"
  say "  oder im Terminal:"
  say "  avery mail setup       (je Konto und Kalender die Stufe waehlen: aus/lesen/schreiben; macOS fragt einmal nach der Automation-Berechtigung)"
  say "  avery mail selftest    (Lesezugriff pruefen)"
  say "  avery up               (Modell als Dienst starten und Goose oeffnen)"
}

cmd_mail() {
  local bin
  if [ $# -eq 0 ]; then set -- help; fi
  bin="$(mail_bin)"
  if [ "${AVERY_DRY_RUN:-}" != "1" ] && [ ! -x "$bin" ]; then
    die "avery-mail fehlt: $bin (im Checkout: cargo build --release --manifest-path avery-mail/Cargo.toml)"
  fi
  launch "$bin" "$@"
}

cmd_model() {
  local splash
  splash="$(command -v splash 2>/dev/null || true)"
  if [ -z "$splash" ]; then
    [ "${AVERY_DRY_RUN:-}" = "1" ] || die "Splash fehlt. Installieren mit: brew install incoai/tap/splash"
    splash="splash"
  fi
  local args=(serve
    --model "${AVERY_MODEL:-unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_M}"
    --served-model-name splash-local
    --max-memory "${AVERY_MAX_MEMORY:-28G}"
    --max-context "${AVERY_MAX_CONTEXT:-100K}"
    --max-cache-disk "${AVERY_MAX_CACHE_DISK:-4G}")
  if [ "${AVERY_OFFLINE:-1}" = "1" ]; then args+=(--offline); fi
  launch "$splash" "${args[@]}" "$@"
}

cmd_pull() {
  say "Das Modell wird einmalig geladen (ca. 17 GB). Sobald 'Ready' erscheint, mit Ctrl+C beenden."
  AVERY_OFFLINE=0 cmd_model "$@"
}

cmd_app() {
  first_setup
  open_goose
}

open_goose() {
  if [ "${AVERY_DRY_RUN:-}" != "1" ]; then
    [ -d "$GOOSE_APP" ] || die "Goose Desktop fehlt. Installieren mit: brew install --cask block-goose"
    [ -f "$GOOSE_ROOT/config/config.yaml" ] || die "Profil fehlt. Zuerst: avery init"
    model_healthy || say "Hinweis: Das Modell laeuft nicht. Mit 'avery up' starten." >&2
    if goose_running; then
      if goose_uses_profile; then
        say "Goose laeuft bereits mit dem Avery-Profil."
        launch open -a "$GOOSE_APP"
      fi
      die "Goose laeuft bereits mit einem anderen Profil (z. B. dem Standardprofil). Bitte beenden (Cmd+Q) und danach erneut starten."
    fi
  fi
  launch open -n -a "$GOOSE_APP" \
    --env "GOOSE_PATH_ROOT=$GOOSE_ROOT" \
    --env "GOOSE_MOIM_MESSAGE_FILE=$GOOSE_ROOT/top-of-mind.md"
}

cmd_cli() {
  local bin="$GOOSE_APP/Contents/Resources/bin/goose"
  if [ "${AVERY_DRY_RUN:-}" != "1" ]; then
    [ -x "$bin" ] || die "Goose CLI nicht gefunden: $bin"
  fi
  export GOOSE_PATH_ROOT="$GOOSE_ROOT" GOOSE_MOIM_MESSAGE_FILE="$GOOSE_ROOT/top-of-mind.md"
  launch "$bin" "$@"
}

cmd_up() {
  local waited=0 limit="${AVERY_UP_TIMEOUT:-240}" started=0
  if model_healthy; then
    say "Das Modell laeuft bereits."
    first_setup
  else
    if [ "${AVERY_OFFLINE:-1}" = "1" ] && [ "${AVERY_DRY_RUN:-}" != "1" ] && ! model_cached; then
      die "Das Modell ist noch nicht geladen. Einmalig 'avery pull' ausfuehren (laedt ca. 17 GB, mit Ctrl+C beenden, sobald es 'Ready' meldet)."
    fi
    say "Modell wird als Dienst gestartet (brew services) ..."
    run_cmd "$(brew_bin)" services run avery || die "Der Dienst liess sich nicht starten (ist avery per Homebrew installiert?)."
    started=1
    first_setup
    if [ "${AVERY_DRY_RUN:-}" != "1" ]; then
      say "Warte auf das Modell, das Laden dauert 1-2 Minuten ..."
      while ! model_healthy; do
        sleep 3
        waited=$((waited + 3))
        if [ "$waited" -ge "$limit" ]; then
          die "Das Modell ist nach ${limit} s nicht bereit. Log: $("$(brew_bin)" --prefix)/var/log/avery-model.log"
        fi
      done
      say "Modell bereit."
    fi
  fi
  # Only a model that "avery up" started is stopped automatically. A model started by hand or with
  # "brew services start avery" (at login) stays under your control.
  if [ "$started" = "1" ]; then start_watcher; fi
  open_goose
}

# Internal: stops the model service when Goose has been closed for AVERY_IDLE_MINUTES.
cmd_watch() {
  local interval="${AVERY_WATCH_INTERVAL:-15}" gone=0 limit pidfile
  limit="${AVERY_IDLE_SECONDS:-$(( ${AVERY_IDLE_MINUTES:-5} * 60 ))}"
  pidfile="$(watch_pidfile)"
  mkdir -p "$AVERY_HOME"
  if watcher_alive && [ "$(cat "$pidfile")" != "$$" ]; then
    say "Der Waechter laeuft bereits (PID $(cat "$pidfile"))."
    return 0
  fi
  echo "$$" > "$pidfile"
  trap 'rm -f "$(watch_pidfile)"' EXIT
  trap 'exit 0' TERM INT HUP
  say "$(date '+%H:%M:%S') Waechter gestartet: das Modell stoppt $limit s nach dem Schliessen von Goose."
  while :; do
    if goose_running; then gone=0; else gone=$((gone + interval)); fi
    if ! model_healthy; then
      say "$(date '+%H:%M:%S') Das Modell laeuft nicht mehr, der Waechter endet."
      return 0
    fi
    if [ "$gone" -ge "$limit" ]; then
      say "$(date '+%H:%M:%S') Goose ist seit $gone s geschlossen: Modell wird gestoppt."
      run_cmd "$(brew_bin)" services stop avery
      return 0
    fi
    sleep "$interval"
  done
}

cmd_down() {
  stop_watcher
  run_cmd "$(brew_bin)" services stop avery
  say "Modell beendet. Goose Desktop schliesst du mit Cmd+Q."
}

cmd_install_app() {
  local dir="${AVERY_APP_DIR:-$HOME/Applications}" cmd icon version major
  # With the cask the app is already in /Applications; a second copy would show up twice in Spotlight and Launchpad.
  if [ -z "${AVERY_APP_DIR:-}" ] && [ -d "$SYSTEM_APP" ]; then
    say "Avery.app ist schon installiert: $SYSTEM_APP (Homebrew-Cask)."
    if [ -d "$dir/Avery.app" ] && ! [ "$dir/Avery.app" -ef "$SYSTEM_APP" ]; then
      rm -rf "$dir/Avery.app"
      say "Die doppelte App in $dir wurde entfernt."
    fi
    return 0
  fi
  cmd="${AVERY_APP_COMMAND:-$(command -v avery 2>/dev/null || echo "$SELF")}"
  # macOS 26 masks full-bleed icons itself; older versions need the squircle with margin.
  version="${AVERY_MACOS_VERSION:-$(sw_vers -productVersion 2>/dev/null || echo 0)}"
  major="${version%%.*}"
  icon="$SHARE/AveryClassic.icns"
  if [ "${major:-0}" -ge 26 ] 2>/dev/null; then icon="$SHARE/Avery.icns"; fi
  mkdir -p "$dir"
  if [ -d "$dir/Avery beenden.app" ]; then
    rm -rf "$dir/Avery beenden.app"
    say "Die alte App 'Avery beenden.app' wurde entfernt, das Modell stoppt jetzt von selbst."
  fi
  "$LIBEXEC/avery-make-app" --output "$dir/Avery.app" --command "$cmd" --version "$AVERY_VERSION" --icon "$icon" >/dev/null
  say "Angelegt: $dir/Avery.app"
  say "Oeffnen per Spotlight (Cmd+Leertaste, 'Avery') oder ins Dock ziehen: startet das Modell und oeffnet Goose."
  say "Das Modell stoppt von selbst, wenn Goose einige Minuten geschlossen ist (AVERY_IDLE_MINUTES, Standard 5)."
  say "Das normale Goose-Symbol oeffnet das Standardprofil und nicht das von Avery."
  say "Einfacher geht es mit dem Cask: brew install --cask flavioaiello/avery/avery"
}

cmd_doctor() {
  local missing=0 version yaml yaml_rc mail
  ok()   { printf '  ok      %s\n' "$*"; }
  miss() { printf '  FEHLT   %s\n' "$*"; missing=$((missing + 1)); }
  say "Avery $AVERY_VERSION"
  if [ "$(uname -s)" = "Darwin" ]; then ok "macOS $(sw_vers -productVersion 2>/dev/null || echo '?')"; else miss "kein macOS"; fi
  if [ -d "$GOOSE_APP" ]; then
    version="$(defaults read "$GOOSE_APP/Contents/Info" CFBundleShortVersionString 2>/dev/null || echo '?')"
    ok "Goose Desktop $version ($GOOSE_APP)"
  else
    miss "Goose Desktop -> brew install --cask block-goose"
  fi
  if command -v splash >/dev/null 2>&1; then ok "Splash ($(command -v splash))"; else miss "Splash -> brew install incoai/tap/splash"; fi
  if [ -d "$SYSTEM_APP" ]; then
    ok "Avery.app ($SYSTEM_APP)"
  elif [ -d "$HOME/Applications/Avery.app" ]; then
    ok "Avery.app ($HOME/Applications)"
  else
    printf '  Hinweis Avery.app fehlt (optional) -> brew install --cask flavioaiello/avery/avery\n'
  fi
  if model_cached; then ok "Modell im Cache"; else miss "Modell nicht im Cache -> avery pull"; fi
  if model_healthy; then ok "Modellserver laeuft"; else miss "Modellserver laeuft nicht -> avery up"; fi
  if [ -f "$GOOSE_ROOT/config/config.yaml" ]; then
    ok "Goose-Profil ($GOOSE_ROOT)"
    for yaml in config.yaml permission.yaml; do
      if [ -f "$GOOSE_ROOT/config/$yaml" ]; then
        yaml_rc=0
        yaml_valid "$GOOSE_ROOT/config/$yaml" || yaml_rc=$?
        case "$yaml_rc" in
          0) ok "YAML gueltig: $yaml" ;;
          1) miss "YAML UNGUELTIG: $GOOSE_ROOT/config/$yaml (Goose kann die Konfiguration nicht laden)" ;;
        esac
      fi
    done
    if grep -q "mail__send_message" "$GOOSE_ROOT/config/permission.yaml" 2>/dev/null \
      && grep -q "mail__delete_event" "$GOOSE_ROOT/config/permission.yaml" 2>/dev/null; then
      ok "Senden und Kalenderaenderungen in Goose auf 'nachfragen' gestellt"
    else
      miss "permission.yaml: mail__send_message oder mail__delete_event fehlt unter ask_before (avery init --force)"
    fi
  else
    miss "Goose-Profil -> avery init"
  fi
  mail="$(mail_bin)"
  if [ -x "$mail" ]; then
    ok "avery-mail ($mail)"
    if ! "$mail" status | sed 's/^/  /'; then
      miss "Mail-Konfiguration unlesbar oder in unbekanntem Format (avery mail status)"
    fi
  else
    miss "avery-mail fehlt: $mail"
  fi
  say ""
  if [ "$missing" -eq 0 ]; then say "Alles bereit."; else say "$missing Punkt(e) offen."; return 1; fi
}

main() {
  local cmd="${1:-help}"
  if [ $# -gt 0 ]; then shift; fi
  cmd="${cmd%[.,;:]}"
  case "$cmd" in
    init) cmd_init "$@" ;;
    mail) cmd_mail "$@" ;;
    watch) cmd_watch "$@" ;;
    install-app) cmd_install_app "$@" ;;
    up) cmd_up "$@" ;;
    down) cmd_down "$@" ;;
    pull) cmd_pull "$@" ;;
    model) cmd_model "$@" ;;
    app) cmd_app "$@" ;;
    cli) cmd_cli "$@" ;;
    doctor) cmd_doctor "$@" ;;
    version|-V|--version) say "avery $AVERY_VERSION" ;;
    help|-h|--help) usage ;;
    *) printf 'avery: unbekannter Befehl: %s\n\n' "$cmd" >&2; usage >&2; return 2 ;;
  esac
}

main "$@"
