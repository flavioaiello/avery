# Avery settings: KEY=VALUE per line, no quotes, no spaces around "=".
# Lines starting with # are ignored. Values from the real environment win.
#
# Local model (avery model). The defaults are tuned for a 48 GB Apple silicon Mac.
#AVERY_MODEL=unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_M
#AVERY_MAX_MEMORY=28G
#AVERY_MAX_CONTEXT=100K
#AVERY_MAX_CACHE_DISK=4G
# 1 (default) = never download anything on its own, use only the cached model.
# "avery pull" downloads the model once; set 0 only if you want updates at every start.
#AVERY_OFFLINE=1
#
# Locations
#AVERY_GOOSE_APP=/Applications/Goose.app
#AVERY_GOOSE_ROOT=/absolute/path/to/goose-profile
