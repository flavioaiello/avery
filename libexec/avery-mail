class FakeBackend(object):
    _INBOX = {"FAKE-GMAIL": "INBOX", "FAKE-OUTLOOK": "Inbox", "FAKE-WORK": "Inbox"}

    def all_accounts(self):
        return [dict(a) for a in FAKE_ACCOUNTS]

    def account_info(self, acc):
        for entry in FAKE_ACCOUNTS:
            if entry["id"] == acc["id"]:
                return dict(entry)
        raise ToolError(_map_error("account_not_found"))

    def mailboxes(self, acc, depth=2):
        boxes = {"FAKE-GMAIL": [("INBOX", 3), ("[Gmail]", 0), ("[Gmail]/All Mail", 3), ("[Gmail]/Sent Mail", 0)],
                 "FAKE-OUTLOOK": [("Inbox", 1), ("Sent Items", 0), ("Archive", 0)],
                 "FAKE-WORK": [("Inbox", 1)]}
        return [{"path": path, "unread": unread} for path, unread in boxes.get(acc["id"], [])]

    def _box(self, acc, mailbox):
        box = self._INBOX[acc["id"]]
        if mailbox and mailbox.lower() not in (box.lower(), "inbox"):
            raise ToolError(_map_error("mailbox_not_found"))
        return box

    def messages(self, acc, mailbox, since_days, unread_only, query, field, limit):
        box = self._box(acc, mailbox)
        cutoff = time.time() - since_days * 86400
        rows = []
        for msg in _fake_messages().get(acc["id"], []):
            if msg["ts"] < cutoff or (unread_only and msg["read"]):
                continue
            if query:
                q, subject, sender = query.lower(), msg["subject"].lower(), msg["from"].lower()
                if field == "subject":
                    hit = q in subject
                elif field == "sender":
                    hit = q in sender
                else:
                    hit = q in subject or q in sender
                if not hit:
                    continue
            rows.append(msg)
        rows.sort(key=lambda m: m["ts"], reverse=True)
        items = [{"id": m["id"], "subject": m["subject"], "from": m["from"], "ts": int(m["ts"]),
                  "date": time.strftime("%Y-%m-%d %H:%M", time.localtime(m["ts"])),
                  "read": m["read"], "flagged": False} for m in rows[:limit]]
        return {"mailbox": box, "total": len(rows), "items": items}

    def read(self, acc, mailbox, msg_id, max_chars):
        box = self._box(acc, mailbox)
        for msg in _fake_messages().get(acc["id"], []):
            if msg["id"] == msg_id:
                body = msg["body"]
                return {"mailbox": box, "id": msg_id, "subject": msg["subject"], "from": msg["from"],
                        "ts": int(msg["ts"]), "date": time.strftime("%Y-%m-%d %H:%M", time.localtime(msg["ts"])),
                        "read": msg["read"],
                        "to": [{"name": n, "address": a} for n, a in msg["to"]], "cc": [],
                        "attachments": [{"name": n, "size": s} for n, s in msg["attachments"]],
                        "bodyChars": len(body), "body": body[:max_chars]}
        raise ToolError(_map_error("can't get message", "read"))

    def compose(self, acc, req):
        """Simulates Mail. The approval answer comes from MAIL_MCP_FAKE_APPROVE (default: no)."""
        if os.environ.get("MAIL_MCP_FAKE_CRASH") == "1":
            raise RuntimeError("simulated crash")
        if os.environ.get("MAIL_MCP_FAKE_UNCERTAIN") == "1":
            raise _failure("timed out", "compose")
        to, subject, reply = list(req["to"]), req["subject"], None
        if req.get("reply"):
            self._box(acc, req["reply"].get("mailbox"))
            found = [m for m in _fake_messages().get(acc["id"], []) if m["id"] == req["reply"]["id"]]
            if not found:
                raise ToolError(_map_error("can't get message", "compose"))
            reply = {"subject": found[0]["subject"], "from": found[0]["from"]}
            match = re.search(r"<([^<>]+)>", found[0]["from"])
            to = [match.group(1) if match else found[0]["from"]]
            subject = "Re: " + found[0]["subject"]
        preview = {"from": "Demo <%s>" % acc["addresses"][0], "to": to, "cc": list(req["cc"]),
                   "subject": subject, "body": req["body"], "reply": reply}
        if req["mode"] == "draft":
            preview.update(status="drafted", saved=True)
        else:
            answer = os.environ.get("MAIL_MCP_FAKE_APPROVE", "no")
            preview["status"] = {"yes": "sent", "timeout": "timeout"}.get(answer, "declined")
        outbox = os.environ.get("MAIL_MCP_FAKE_OUTBOX")
        if outbox and preview["status"] in ("sent", "drafted"):
            with open(outbox, "a", encoding="utf-8") as handle:
                handle.write(json.dumps(preview, ensure_ascii=False) + "\n")
        return preview

    def approval_test(self, seconds=20):
        return {"decision": os.environ.get("MAIL_MCP_FAKE_APPROVE_TEST", "send")}


BACKEND = FakeBackend() if FAKE else RealBackend()


# ---------------------------------------------------------------------- tools

def _fmt_item(label, box, item):
    flags = []
    if not item.get("read"):
        flags.append("UNREAD")
    if item.get("flagged"):
        flags.append("FLAGGED")
    return "- [%s/%s] id=%s | %s | %s | From: %s | Subject: %s" % (
        label, box, item.get("id"), item.get("date"), ",".join(flags) or "read",
        one_line(item.get("from"), 80), one_line(item.get("subject"), 140))


def _collect(args, since_days, unread_only, query, field, limit):
    accounts = resolve(args.get("account"))
    mailbox = clean(args.get("mailbox"), 120) or None
    rows, totals, problems = [], [], []
    for acc in accounts:
        try:
            result = BACKEND.messages(acc, mailbox, since_days, unread_only, query, field, limit)
        except ToolError as exc:
            problems.append("! %s: %s" % (acc["label"], exc))
            continue
        box = result.get("mailbox") or mailbox or "INBOX"
        totals.append("%s/%s: %s matches" % (acc["label"], box, result.get("total", 0)))
        for item in result.get("items", []):
            rows.append((item.get("ts", 0), acc["label"], box, item))
    if problems and len(problems) == len(accounts):
        raise ToolError("\n".join(problems))
    rows.sort(key=lambda row: row[0], reverse=True)
    shown = rows[:limit]
    lines = [UNTRUSTED, "Newest first, showing %d. %s" % (len(shown), "; ".join(totals))]
    lines += [_fmt_item(label, box, item) for _, label, box, item in shown]
    if not shown:
        lines.append("(no messages found)")
    return "\n".join(lines + problems)


def tool_list_accounts(args):
    accounts = allowed_accounts()
    if not accounts:
        raise ToolError(NO_ACCOUNTS)
    lines = []
    for acc in accounts:
        info, note = dict(acc), ""
        try:
            info.update(BACKEND.account_info(acc))
        except ToolError as exc:
            note = " (not reachable: %s)" % exc
        lines.append("- %s [%s]: %s%s" % (acc["label"], info.get("type") or "?",
                                          ", ".join(info.get("addresses") or []) or "-", note))
    return "\n".join(lines)


def tool_list_mailboxes(args):
    lines = [UNTRUSTED]
    for acc in resolve(args.get("account")):
        try:
            boxes = BACKEND.mailboxes(acc)
        except ToolError as exc:
            lines.append("! %s: %s" % (acc["label"], exc))
            continue
        lines.append("%s:" % acc["label"])
        lines += ["  %s (unread %s)" % (clean(b.get("path"), 120), b.get("unread", 0)) for b in boxes]
    return "\n".join(lines)


def tool_list_messages(args):
    return _collect(args, to_int(args.get("since_days"), 3, 1, 365), to_bool(args.get("unread_only")),
                    None, "both", to_int(args.get("limit"), 20, 1, 50))


def tool_search_messages(args):
    query = clean(args.get("query"), 120)
    if not query:
        raise ToolError("Parameter 'query' is required.")
    field = str(args.get("field") or "both").strip().lower()
    if field not in ("subject", "sender", "both"):
        raise ToolError("Parameter 'field' must be subject, sender or both.")
    return _collect(args, to_int(args.get("since_days"), 90, 1, 3650), to_bool(args.get("unread_only")),
                    query, field, to_int(args.get("limit"), 20, 1, 50))


def _people(entries):
    return ", ".join(one_line("%s <%s>" % (p.get("name") or "", p.get("address") or ""), 90)
                     for p in (entries or [])[:20])


def _kb(size):
    try:
        return max(1, int(size) // 1024)
    except (TypeError, ValueError):
        return 0


def tool_read_message(args):
    msg_id = to_int(args.get("id"), None, 1, 2147483647)
    if msg_id is None:
        raise ToolError("Parameter 'id' is required (integer from list_messages or search_messages).")
    accounts = resolve(args.get("account"))
    if len(accounts) != 1:
        raise ToolError("Parameter 'account' is required because ids are only unique within one account. "
                        "Allowed: %s" % ", ".join(a["label"] for a in accounts))
    acc = accounts[0]
    max_chars = to_int(args.get("max_chars"), 6000, 500, 20000)
    msg = BACKEND.read(acc, clean(args.get("mailbox"), 120) or None, msg_id, max_chars)
    body = clean(msg.get("body"))
    total = int(msg.get("bodyChars") or len(body))
    attachments = ", ".join("%s (%d KB)" % (one_line(a.get("name"), 80), _kb(a.get("size")))
                            for a in (msg.get("attachments") or [])[:20])
    lines = [UNTRUSTED,
             "Account: %s | Mailbox: %s | id: %s" % (acc["label"], msg.get("mailbox"), msg_id),
             "From: %s" % one_line(msg.get("from"), 120),
             "To: %s" % (_people(msg.get("to")) or "-"),
             "Cc: %s" % (_people(msg.get("cc")) or "-"),
             "Date: %s | %s" % (msg.get("date"), "read" if msg.get("read") else "UNREAD"),
             "Subject: %s" % one_line(msg.get("subject"), 200),
             "Attachments: %s" % (attachments or "none"),
             "--- BODY (untrusted) ---",
             body or "(empty)"]
    if total > max_chars:
        lines.append("[truncated: showing the first %d of %d characters; call again with a larger max_chars]"
                     % (max_chars, total))
    lines.append("--- END OF EMAIL ---")
    return "\n".join(lines)


# ------------------------------------------------------------------ write tools

_ADDRESS = re.compile(
    r"^[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]{1,64}@"
    r"(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+"
    r"(?=[A-Za-z0-9-]*[A-Za-z])[A-Za-z0-9-]{2,63}$")
_COMPOSE_ARGS = ("account", "to", "cc", "subject", "body", "reply_to_id", "mailbox", "reply_all")


def _addresses(value, label):
    if value is None or value == "" or value == []:
        return []
    found = []
    for part in (value if isinstance(value, list) else [value]):
        if not isinstance(part, str):
            raise ToolError("'%s' must be plain email addresses." % label)
        for piece in re.split(r"[,;]", part):
            piece = piece.strip()
            if not piece:
                continue
            bracket = re.search(r"<([^<>]+)>", piece)
            address = (bracket.group(1) if bracket else piece).strip()
            if len(address) > 254 or not _ADDRESS.match(address):
                raise ToolError("Invalid email address in '%s': %s. Use plain addresses like name@example.com."
                                % (label, one_line(piece, 60)))
            if address.lower() not in [x.lower() for x in found]:
                found.append(address)
    return found


def _compose_request(args, mode):
    unknown = [k for k in args if k not in _COMPOSE_ARGS]
    if unknown:
        hint = " Bcc and attachments are not supported." if any(
            str(k).lower() in ("bcc", "attachments", "attachment") for k in unknown) else ""
        raise ToolError("Unknown parameter(s): %s.%s" % (", ".join(clean(k, 30) for k in unknown), hint))
    acc, settings = resolve_writable(args.get("account"))
    body = clean(args.get("body"))
    if not body:
        raise ToolError("Parameter 'body' is required.")
    if mode == "send" and len(body) > MAX_SEND_CHARS:
        raise ToolError("The text has %d characters but send_message allows %d. Use create_draft so that the "
                        "user can read and send it in Mail." % (len(body), MAX_SEND_CHARS))
    if len(body) > MAX_DRAFT_CHARS:
        raise ToolError("The text is too long (max %d characters)." % MAX_DRAFT_CHARS)
    to, cc = _addresses(args.get("to"), "to"), _addresses(args.get("cc"), "cc")
    cc = [a for a in cc if a.lower() not in [x.lower() for x in to]]
    subject = one_line(args.get("subject"), MAX_SUBJECT + 1)
    if len(subject) > MAX_SUBJECT:
        raise ToolError("The subject is too long (max %d characters)." % MAX_SUBJECT)
    reply_id = None
    raw_id = args.get("reply_to_id")
    if raw_id is not None and raw_id != "":
        reply_id = to_int(raw_id, None, -2147483648, 2147483647)
        if reply_id is None or reply_id < 1:
            raise ToolError("Parameter 'reply_to_id' must be a message id from list_messages or search_messages.")
    reply = None
    if reply_id is not None:
        if to or cc or subject:
            raise ToolError("For an answer do not pass 'to', 'cc' or 'subject': Mail takes the recipients and "
                            "the subject from the original message.")
        reply = {"mailbox": clean(args.get("mailbox"), 120) or None, "id": reply_id,
                 "all": to_bool(args.get("reply_all"))}
    else:
        if not to:
            raise ToolError("Parameter 'to' is required (or reply_to_id for an answer).")
        if not subject:
            raise ToolError("Parameter 'subject' is required.")
        if len(to) + len(cc) > MAX_RECIPIENTS:
            raise ToolError("Too many recipients (max %d)." % MAX_RECIPIENTS)
    return acc, settings, {"mode": mode, "to": to, "cc": cc, "subject": subject, "body": body, "reply": reply}


def _log_attempt(mode, acc, req, outcome, preview=None, attempt_id=None, strict=False):
    preview = preview or {}
    entry = {
        "ts": int(time.time()), "mode": mode, "outcome": outcome, "account": acc["label"],
        "from": one_line(preview.get("from"), 120), "to": preview.get("to") or req["to"],
        "cc": preview.get("cc") or req["cc"],
        "subject": one_line(preview.get("subject") or req["subject"], MAX_SUBJECT),
        "reply_to_id": (req["reply"] or {}).get("id"), "chars": len(req["body"]),
        "sha256": hashlib.sha256(req["body"].encode("utf-8")).hexdigest()[:16]}
    if attempt_id:
        entry["id"] = attempt_id
    append_sendlog(entry, strict=strict)


def _summary(preview):
    lines = ["From: %s" % one_line(preview.get("from"), 120),
             "To: %s" % (", ".join(one_line(x, 100) for x in preview.get("to") or []) or "-")]
    if preview.get("cc"):
        lines.append("Cc: %s" % ", ".join(one_line(x, 100) for x in preview["cc"]))
    lines.append("Subject: %s" % one_line(preview.get("subject"), MAX_SUBJECT))
    return "\n".join(lines)


def tool_create_draft(args):
    acc, settings, req = _compose_request(args, "draft")
    try:
        preview = BACKEND.compose(acc, req)
    except ToolError:
        _log_attempt("draft", acc, req, "error")
        raise
    _log_attempt("draft", acc, req, "drafted", preview)
    note = "" if preview.get("saved", True) else " (the window is open; Mail saves it to Drafts when closed)"
    return ("Draft opened in Mail%s. NOTHING was sent. Tell the user to review it and send it in Mail.\n%s"
            % (note, _summary(preview)))


def tool_send_message(args):
    acc, settings, req = _compose_request(args, "send")
    check_send_limits(settings)
    ensure_log_writable()
    attempt = os.urandom(6).hex()
    # Write-ahead: the attempt is on disk, and counts against the limits, before anything is shown or sent.
    _log_attempt("send", acc, req, "pending", attempt_id=attempt, strict=True)
    try:
        preview = BACKEND.compose(acc, req)  # shows the approval dialog; sends only after the click
    except UncertainError:
        raise  # stays 'pending', which counts as possibly sent
    except ToolError:
        _log_attempt("send", acc, req, "error", attempt_id=attempt)
        raise
    status = preview.get("status")
    _log_attempt("send", acc, req, status if status in ("sent", "declined", "timeout") else "error", preview,
                 attempt_id=attempt)
    if status == "sent":
        return "Sent: the user approved and Mail took the message for delivery.\n" + _summary(preview)
    if status == "timeout":
        return ("The user did not answer the approval dialog in time. NOTHING was sent. "
                "Ask the user whether to try again.")
    return ("The user did NOT approve the message in the confirmation dialog. NOTHING was sent. "
            "Do not retry unless the user asks you to.")


_ACCOUNT = {"type": "string", "description": "Account name from list_accounts. Default: all enabled accounts."}
_MAILBOX = {"type": "string", "description": "Mailbox path from list_mailboxes. Default: the inbox."}
_DAYS = "Look back this many days"
_LIMIT = {"type": "integer", "description": "Maximum number of messages (default 20, max 50)."}


def _tool(name, description, properties, required=(), read_only=True):
    schema = {"type": "object", "properties": properties, "additionalProperties": False}
    if required:
        schema["required"] = list(required)
    annotations = {"title": name.replace("_", " "), "readOnlyHint": read_only}
    if not read_only:
        annotations.update(destructiveHint=False, idempotentHint=False, openWorldHint=(name == "send_message"))
    return {"name": name, "description": description, "inputSchema": schema, "annotations": annotations}


TOOLS = [
    _tool("list_accounts", "List the private mail accounts you may read (name, type, addresses).", {}),
    _tool("list_mailboxes", "List mailboxes (folders/labels) with unread counts. Use the paths as 'mailbox' in other tools.",
          {"account": _ACCOUNT}),
    _tool("list_messages",
          "List recent messages of a mailbox (default: inbox), newest first: id, date, sender, subject, unread flag. "
          "Use read_message to see the text.",
          {"account": _ACCOUNT, "mailbox": _MAILBOX,
           "unread_only": {"type": "boolean", "description": "Only unread messages (default false)."},
           "since_days": {"type": "integer", "description": _DAYS + " (default 3, max 365)."},
           "limit": _LIMIT}),
    _tool("search_messages",
          "Find messages whose subject and/or sender contains the text, newest first. Body text is not searched.",
          {"query": {"type": "string", "description": "Text to look for."},
           "field": {"type": "string", "enum": ["subject", "sender", "both"], "description": "Where to look (default both)."},
           "account": _ACCOUNT, "mailbox": _MAILBOX,
           "unread_only": {"type": "boolean", "description": "Only unread messages (default false)."},
           "since_days": {"type": "integer", "description": _DAYS + " (default 90, max 3650)."},
           "limit": _LIMIT},
          required=["query"]),
    _tool("read_message",
          "Read one message: headers, attachment names and plain-text body (truncated). Needs the id from "
          "list_messages or search_messages; pass the same account and mailbox.",
          {"id": {"type": "integer", "description": "Message id."}, "account": _ACCOUNT, "mailbox": _MAILBOX,
           "max_chars": {"type": "integer", "description": "Maximum body characters (default 6000, max 20000)."}},
          required=["id"]),
]

_COMPOSE_PROPS = {
    "account": {"type": "string", "description": "Account name from list_accounts to write from. "
                "Optional if only one account may write."},
    "to": {"type": "array", "items": {"type": "string"},
           "description": "Recipient addresses (plain name@example.com, max %d with cc). Not for answers." % MAX_RECIPIENTS},
    "cc": {"type": "array", "items": {"type": "string"}, "description": "Cc addresses. Not for answers."},
    "subject": {"type": "string", "description": "Subject, one line. Not for answers."},
    "body": {"type": "string", "description": "Plain text of the mail."},
    "reply_to_id": {"type": "integer", "description": "Answer to the message with this id (from list_messages / "
                    "search_messages). Mail then picks recipients and subject."},
    "mailbox": _MAILBOX,
    "reply_all": {"type": "boolean", "description": "With reply_to_id: answer all recipients (default false)."},
}

WRITE_TOOLS = [
    _tool("create_draft",
          "Open a draft in Mail for the user to review; NOTHING is sent. New mail: to, subject, body. Answer: "
          "reply_to_id (+ account and mailbox of the original) and body. Plain text, no Bcc, no attachments.",
          _COMPOSE_PROPS, required=["body"], read_only=False),
    _tool("send_message",
          "Send a mail. The user must approve each mail in a macOS dialog showing recipients and text; "
          "if they decline, nothing is sent. New mail: to, subject, body. Answer: reply_to_id (+ account and "
          "mailbox of the original) and body. Plain text up to %d characters, no Bcc, no attachments; "
          "longer texts must be drafts." % MAX_SEND_CHARS,
          _COMPOSE_PROPS, required=["body"], read_only=False),
]

HANDLERS = {
    "list_accounts": tool_list_accounts,
    "list_mailboxes": tool_list_mailboxes,
    "list_messages": tool_list_messages,
    "search_messages": tool_search_messages,
    "read_message": tool_read_message,
    "create_draft": tool_create_draft,
    "send_message": tool_send_message,
}


def tools_list():
    try:
        writable = bool(write_settings()["accounts"])
    except ToolError:
        writable = False
    return TOOLS + (WRITE_TOOLS if writable else [])


def instructions():
    try:
        writable = bool(write_settings()["accounts"])
    except ToolError:
        writable = False
    return READ_INSTRUCTIONS + (WRITE_INSTRUCTIONS if writable else "")


# ------------------------------------------------------------------ MCP server

def _reply(msg_id, result=None, error=None):
    payload = {"jsonrpc": "2.0", "id": msg_id}
    if error is not None:
        payload["error"] = error
    else:
        payload["result"] = result
    sys.stdout.write(json.dumps(payload) + "\n")
    sys.stdout.flush()


def call_tool(params):
    name = params.get("name")
    args = params.get("arguments")
    handler = HANDLERS.get(name)
    if handler is None:
        return {"content": [{"type": "text", "text": "Unknown tool: %s" % clean(name, 40)}], "isError": True}
    try:
        text = handler(args if isinstance(args, dict) else {})
        return {"content": [{"type": "text", "text": text}], "isError": False}
    except ToolError as exc:
        return {"content": [{"type": "text", "text": str(exc)}], "isError": True}
    except Exception as exc:  # never leak mail content through tracebacks
        print("internal error in %s: %s" % (name, type(exc).__name__), file=sys.stderr, flush=True)
        return {"content": [{"type": "text", "text": "Internal error (%s). Please retry." % type(exc).__name__}],
                "isError": True}


def handle(message):
    method, msg_id = message.get("method"), message.get("id")
    params = message.get("params") if isinstance(message.get("params"), dict) else {}
    if method is None or msg_id is None:
        return  # notification or response: nothing to answer
    if method == "initialize":
        _reply(msg_id, {"protocolVersion": params.get("protocolVersion") or "2024-11-05",
                        "capabilities": {"tools": {"listChanged": False}},
                        "serverInfo": {"name": SERVER_NAME, "version": VERSION},
                        "instructions": instructions()})
    elif method == "ping":
        _reply(msg_id, {})
    elif method == "tools/list":
        _reply(msg_id, {"tools": tools_list()})
    elif method == "tools/call":
        _reply(msg_id, call_tool(params))
    elif method == "resources/list":
        _reply(msg_id, {"resources": []})
    elif method == "resources/templates/list":
        _reply(msg_id, {"resourceTemplates": []})
    elif method == "prompts/list":
        _reply(msg_id, {"prompts": []})
    else:
        _reply(msg_id, error={"code": -32601, "message": "Method not found"})


def serve():
    for stream in (sys.stdin, sys.stdout):
        try:
            stream.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError):
            pass
    while True:
        line = sys.stdin.readline()
        if not line:
            break
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if isinstance(message, dict):
            handle(message)
    return 0


# ------------------------------------------------------------------------ CLI

def _print_accounts(accounts, enabled_ids, write_ids=()):
    for number, acc in enumerate(accounts, 1):
        mark = "*" if acc["id"] in enabled_ids else " "
        extra = "  [Entwuerfe/Senden]" if acc["id"] in write_ids else ""
        print("%s %d) %s  [%s]  %s%s" % (mark, number, acc["name"], acc.get("type") or "?",
                                         ", ".join(acc.get("addresses") or []) or "-", extra))


def cmd_accounts():
    try:
        accounts = BACKEND.all_accounts()
        enabled = set(a["id"] for a in allowed_accounts())
        writable = set(a["id"] for a in write_settings()["accounts"])
    except ToolError as exc:
        print("Fehler:", exc)
        return 1
    if not accounts:
        print("Mail kennt noch keine Konten (Systemeinstellungen > Internetaccounts).")
        return 0
    _print_accounts(accounts, enabled, writable)
    print("\n* = zum Lesen fuer den Agenten freigegeben")
    print("[Entwuerfe/Senden] = darf Entwuerfe anlegen und Mails senden (jede Mail nur nach deinem Klick)")
    return 0


def cmd_setup():
    try:
        accounts = BACKEND.all_accounts()
        enabled = set(a["id"] for a in allowed_accounts())
    except ToolError as exc:
        print("Fehler:", exc)
        return 1
    if not accounts:
        print("Mail kennt noch keine Konten. Zuerst in den Systemeinstellungen unter Internetaccounts anmelden.")
        return 1
    _print_accounts(accounts, enabled)
    print("\nNur PRIVATE Konten freigeben, niemals geschaeftliche.")
    try:
        answer = input("Nummern der freizugebenden Konten (z. B. 2 3), leer = nichts aendern: ").strip()
        if not answer:
            print("Unveraendert.")
            return 0
        picks = sorted(set(int(x) for x in re.split(r"[,\s]+", answer) if x))
        if any(p < 1 or p > len(accounts) for p in picks):
            print("Nummer ausserhalb der Liste.")
            return 1
        chosen = [accounts[p - 1] for p in picks]
        print("\nFreigabe fuer:")
        for acc in chosen:
            print("  - %s  [%s]  %s" % (acc["name"], acc.get("type") or "?", ", ".join(acc.get("addresses") or []) or "-"))
        if input("Korrekt? [j/N] ").strip().lower() not in ("j", "ja", "y", "yes"):
            print("Abgebrochen.")
            return 1
    except (ValueError, EOFError):
        print("Ungueltige Eingabe.")
        return 1
    try:
        previous = load_config()
    except ToolError:
        previous = {}
    config = {"version": 2, "allowed_accounts": [
        {"id": a["id"], "name": a["name"], "type": a.get("type") or "", "addresses": a.get("addresses") or []}
        for a in chosen]}
    write = previous.get("write")
    if isinstance(write, dict):
        kept = [i for i in (write.get("accounts") or []) if i in set(a["id"] for a in chosen)]
        if kept:
            config["write"] = dict(write, accounts=kept)
    save_config(config)
    print("Gespeichert in %s" % CONFIG_PATH)
    return 0


def cmd_revoke():
    save_config({"version": 2, "allowed_accounts": []})
    print("Alle Freigaben entfernt (auch Entwuerfe und Senden). Der Agent sieht keine Konten mehr.")
    return 0


def cmd_write_enable():
    try:
        accounts = allowed_accounts()
        current = set(a["id"] for a in write_settings()["accounts"])
    except ToolError as exc:
        print("Fehler:", exc)
        return 1
    if not accounts:
        print(NO_ACCOUNTS)
        return 1
    _print_accounts(accounts, set(a["id"] for a in accounts), current)
    print("\nDamit darf der Agent fuer die gewaehlten Konten Entwuerfe anlegen und Mails senden.")
    print("Jede Mail wird erst gesendet, wenn du in einem macOS-Dialog auf 'Senden' klickst;")
    print("der Agent kann diesen Dialog nicht bedienen.")
    print("Grenzen: Klartext, kein Bcc, keine Anhaenge, max. %d Empfaenger, max. %d Zeichen pro gesendeter Mail,"
          % (MAX_RECIPIENTS, MAX_SEND_CHARS))
    print("         max. %d gesendete Mails pro Stunde. Jeder Versuch steht in %s" % (
        DEFAULT_SENDS_PER_HOUR, sendlog_path()))
    try:
        answer = input("Nummern der Konten mit Entwurf/Senden (z. B. 1 2), leer = nichts aendern: ").strip()
        if not answer:
            print("Unveraendert.")
            return 0
        picks = sorted(set(int(x) for x in re.split(r"[,\s]+", answer) if x))
        if any(p < 1 or p > len(accounts) for p in picks):
            print("Nummer ausserhalb der Liste.")
            return 1
        chosen = [accounts[p - 1] for p in picks]
        print("\nEntwuerfe und Senden (mit Freigabe) fuer:")
        for acc in chosen:
            print("  - %s  %s" % (acc["name"], ", ".join(acc.get("addresses") or []) or "-"))
        if input("Korrekt? [j/N] ").strip().lower() not in ("j", "ja", "y", "yes"):
            print("Abgebrochen.")
            return 1
    except (ValueError, EOFError):
        print("Ungueltige Eingabe.")
        return 1
    config = load_config()
    old = config.get("write") if isinstance(config.get("write"), dict) else {}
    config["version"] = 2
    config["write"] = {"accounts": [a["id"] for a in chosen],
                       "max_per_hour": to_int(old.get("max_per_hour"), DEFAULT_SENDS_PER_HOUR, 1, 30)}
    save_config(config)
    print("Gespeichert. Goose danach neu starten. Pruefen mit: avery mail selftest-write")
    return 0


def cmd_write_disable():
    try:
        config = load_config()
    except ToolError as exc:
        print("Fehler:", exc)
        return 1
    config.pop("write", None)
    save_config(config)
    print("Entwuerfe und Senden sind aus. Lesen bleibt wie freigegeben.")
    return 0


def cmd_sendlog():
    entries = _attempts(read_sendlog(200))
    if not entries:
        print("Noch keine Eintraege.")
        return 0
    names = {"pending": "unklar"}  # started, but no result was recorded: it may have been sent
    for entry in entries[-20:]:
        when = time.strftime("%Y-%m-%d %H:%M", time.localtime(entry.get("ts") or 0))
        print("%s  %-5s %-9s %s -> %s | %s" % (
            when, entry.get("mode"), names.get(entry.get("outcome"), entry.get("outcome")), entry.get("account"),
            ", ".join(entry.get("to") or []) or "-", one_line(entry.get("subject"), 80)))
    print("\nDatei: %s" % sendlog_path())
    return 0


def cmd_status():
    try:
        accounts = allowed_accounts()
        writable = write_settings()["accounts"]
    except ToolError as exc:
        print("Fehler:", exc)
        return 1
    print("Version: %s" % VERSION)
    print("Konfiguration: %s (%s)" % (CONFIG_PATH, "vorhanden" if os.path.exists(CONFIG_PATH) else "fehlt"))
    print("Lesen freigegeben fuer: %s" % (", ".join(a["label"] for a in accounts) or "kein Konto"))
    print("Entwuerfe/Senden: %s" % (", ".join(a["label"] for a in writable) if writable else "aus"))
    return 0


def cmd_selftest():
    try:
        accounts = allowed_accounts()
    except ToolError as exc:
        print("FAIL  config: %s" % exc)
        return 1
    if not accounts:
        print(NO_ACCOUNTS)
        return 1
    failures = []
    for number, acc in enumerate(accounts, 1):
        tag, state = "Konto %d" % number, {}

        def step(title, action):
            started = time.time()
            try:
                detail = action()
            except ToolError as exc:
                failures.append(title)
                print("FAIL  %s  %s: %s" % (tag, title, exc))
                return False
            print("PASS  %s  %s (%.1f s)%s" % (tag, title, time.time() - started, "  " + detail if detail else ""))
            return True

        def check_account():
            return "Typ=%s" % (BACKEND.account_info(acc).get("type") or "?")

        def check_mailboxes():
            return "%d Mailboxen" % len(BACKEND.mailboxes(acc))

        def check_list():
            result = BACKEND.messages(acc, None, 30, False, None, "both", 5)
            state["items"] = result.get("items", [])
            return "Posteingang: %s Treffer in 30 Tagen, %d geladen" % (result.get("total", 0), len(state["items"]))

        def check_read():
            if not state.get("items"):
                return "uebersprungen (keine Nachricht in 30 Tagen)"
            msg = BACKEND.read(acc, None, state["items"][0]["id"], 500)
            return "Text %s Zeichen, %d Anhaenge" % (msg.get("bodyChars"), len(msg.get("attachments") or []))

        def check_search():
            return "%s Treffer" % BACKEND.messages(acc, None, 30, False, "e", "both", 5).get("total", 0)

        if step("Konto erreichbar", check_account):
            step("Mailboxen lesen", check_mailboxes)
            if step("Posteingang listen", check_list):
                step("Nachricht lesen", check_read)
            step("Suche", check_search)
    print()
    if failures:
        print("%d Pruefung(en) fehlgeschlagen." % len(failures))
        return 1
    print("Alle Pruefungen bestanden. Es wurde nichts gesendet, geloescht oder verschoben; "
          "Inhalte wurden nicht ausgegeben.")
    return 0


def cmd_selftest_write():
    try:
        settings = write_settings()
    except ToolError as exc:
        print("FAIL  config: %s" % exc)
        return 1
    if not settings["accounts"]:
        print(WRITE_OFF)
        return 1
    failures = []

    def yes(question):
        try:
            return input(question).strip().lower() in ("j", "ja", "y", "yes")
        except EOFError:
            return False

    print("1) Freigabedialog. Gleich erscheint ein Testdialog, klicke 'Weiter' oder 'Abbrechen'.")
    print("   Es wird nichts gesendet.")
    try:
        decision = BACKEND.approval_test(60).get("decision")
    except ToolError as exc:
        failures.append("dialog")
        print("FAIL  Freigabedialog: %s" % exc)
    else:
        if decision in ("send", "declined"):
            print("PASS  Freigabedialog funktioniert (Antwort: %s)" % ("Weiter" if decision == "send" else "Abbrechen"))
        else:
            failures.append("dialog")
            print("FAIL  Freigabedialog: keine Antwort innerhalb von 60 s")
    for acc in settings["accounts"]:
        try:
            addresses = BACKEND.account_info(acc).get("addresses") or []
        except ToolError as exc:
            failures.append("account")
            print("FAIL  %s: %s" % (acc["label"], exc))
            continue
        if not addresses:
            failures.append("account")
            print("FAIL  %s: Mail kennt keine Absenderadresse fuer dieses Konto" % acc["label"])
            continue
        own = addresses[0]
        print("\n2) Entwurf an dich selbst (%s). Ein Mail-Fenster oeffnet sich, nichts wird gesendet." % acc["label"])
        req = {"mode": "draft", "to": [own], "cc": [], "reply": None,
               "subject": "Scout Selbsttest - Entwurf (bitte loeschen)",
               "body": "Testentwurf. Er wurde nicht gesendet."}
        try:
            preview = BACKEND.compose(acc, req)
            print("PASS  Entwurf angelegt, Absender: %s%s" % (
                one_line(preview.get("from"), 100), "" if preview.get("saved", True) else " (Fenster offen, noch nicht in Entwuerfen)"))
        except ToolError as exc:
            failures.append("draft")
            print("FAIL  Entwurf: %s" % exc)
        if yes("\n3) Test-Mail an dich selbst senden? Der Freigabedialog erscheint. [j/N] "):
            req = {"mode": "send", "to": [own], "cc": [], "reply": None,
                   "subject": "Scout Selbsttest - Mail",
                   "body": "Test des Freigabedialogs. Du kannst diese Mail loeschen."}
            try:
                preview = BACKEND.compose(acc, req)
            except ToolError as exc:
                failures.append("send")
                _log_attempt("send", acc, req, "error")
                print("FAIL  Senden: %s" % exc)
            else:
                status = preview.get("status")
                _log_attempt("send", acc, req, status if status in ("sent", "declined", "timeout") else "error", preview)
                if status == "sent":
                    print("PASS  Mail an %s an Mail uebergeben (Posteingang und Gesendet pruefen)" % own)
                else:
                    print("INFO  Nicht gesendet (%s)" % status)
        if yes("\n4) Antworten testen: Entwurf und Antwort auf die Test-Mail an dich selbst? [j/N] "):
            print("   Suche die Test-Mail 'Scout Selbsttest - Mail' im Posteingang (bis zu 60 s) ...")
            item = None
            rounds = 1 if FAKE else 12
            for number in range(rounds):
                try:
                    items = BACKEND.messages(acc, None, 2, False, "Scout Selbsttest - Mail", "subject", 3).get("items") or []
                except ToolError:
                    items = []
                if items:
                    item = items[0]
                    break
                if number < rounds - 1:
                    time.sleep(5)
            if item is None:
                print("INFO  Test-Mail nicht gefunden, Schritt uebersprungen (zuerst Schritt 3 mit 'j' ausfuehren)")
            else:
                for mode, body in (("draft", "Antwortentwurf. Er wurde nicht gesendet."),
                                   ("send", "Antwort-Test des Freigabedialogs. Du kannst diese Mail loeschen.")):
                    req = {"mode": mode, "to": [], "cc": [], "subject": "", "body": body,
                           "reply": {"mailbox": None, "id": item["id"], "all": False}}
                    if mode == "send":
                        print("   Jetzt erscheint der Freigabedialog fuer die Antwort (geht an dich selbst).")
                    try:
                        preview = BACKEND.compose(acc, req)
                    except ToolError as exc:
                        failures.append("reply-" + mode)
                        print("FAIL  Antwort (%s): %s" % (mode, exc))
                        continue
                    status = preview.get("status")
                    if mode == "send":
                        _log_attempt("send", acc, req, status if status in ("sent", "declined", "timeout") else "error", preview)
                    print("PASS  Antwort (%s): Status %s, An: %s" % (
                        "Entwurf" if mode == "draft" else "senden", status, ", ".join(preview.get("to") or []) or "-"))
    print()
    if failures:
        print("%d Pruefung(en) fehlgeschlagen." % len(failures))
        return 1
    print("Fertig. Test-Entwurf und Test-Mail kannst du loeschen.")
    return 0


def main(argv):
    command = (argv[1] if len(argv) > 1 else "serve").strip().rstrip(".,;:")
    commands = {"serve": serve, "accounts": cmd_accounts, "setup": cmd_setup,
                "revoke": cmd_revoke, "selftest": cmd_selftest,
                "write-enable": cmd_write_enable, "write-disable": cmd_write_disable,
                "sendlog": cmd_sendlog, "selftest-write": cmd_selftest_write, "status": cmd_status}
    if command in ("-V", "--version", "version"):
        print(VERSION)
        return 0
    if command in commands:
        return commands[command]()
    if command in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    print("Unbekannter Befehl: %s" % command)
    close = difflib.get_close_matches(command, list(commands), n=1)
    if close:
        print("Meintest du: avery mail %s" % close[0])
    print("Befehle: %s" % ", ".join(name for name in commands if name != "serve"))
    print("Hilfe: avery mail help")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
